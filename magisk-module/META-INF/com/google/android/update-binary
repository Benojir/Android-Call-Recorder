#!/sbin/sh
# Native KernelSU/Next and APatch installers use customize.sh and ignore this file.
# Magisk executes this entry point. Recovery follows the separate installer below.
OUTFD=${2}
ZIPFILE=${3}
umask 022
ui_print() {
  if [ -e "/proc/self/fd/$OUTFD" ]; then
    printf 'ui_print %s\nui_print\n' "$*" > "/proc/self/fd/$OUTFD"
  else
    printf '%s\n' "$*"
  fi
}
abort() { ui_print "! $*"; exit 1; }

if [ "${BOOTMODE:-false}" = true ] || [ "$(getprop sys.boot_completed 2>/dev/null)" = 1 ]; then
  [ -f /data/adb/magisk/util_functions.sh ] || abort "Use the native KernelSU/Next or APatch module installer in its manager."
  . /data/adb/magisk/util_functions.sh
  install_module
  exit $?
fi

# Recovery: extract only our own installer to a private temporary directory.
WORK="/tmp/call-recorder-installer-$$"
mkdir -p "$WORK" || abort "Cannot create temporary directory."
unzip -p "$ZIPFILE" recovery-install.sh > "$WORK/recovery-install.sh" || abort "Recovery installer missing."
[ -s "$WORK/recovery-install.sh" ] || abort "Recovery installer is empty."
. "$WORK/recovery-install.sh"
