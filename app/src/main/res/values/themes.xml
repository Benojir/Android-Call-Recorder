<resources>
    <!-- Base application theme. -->
    <style name="Theme.VoiceRecorder" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#4057BB</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/theme_color_light</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/backgroundColor</item>

        <!-- Customize your theme here. -->
        <item name="backgroundColor">@color/theme_color_light</item>
        <item name="textColor">@color/black</item>
        <item name="scrollButtonBackgroundColor">@color/theme_color_light</item>
        <item name="colorPrimaryContainer">#E1E5FF</item>
        <item name="colorOnPrimaryContainer">#17234B</item>
        <item name="colorSurface">#FAF8FF</item>
        <item name="colorSurfaceContainer">#F0EFF8</item>
        <item name="colorOnSurface">#1B1B23</item>
        <item name="colorOnSurfaceVariant">#484957</item>
    </style>

    <style name="CustomToolbarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="fontFamily">@font/brandy</item>
    </style>
</resources>
